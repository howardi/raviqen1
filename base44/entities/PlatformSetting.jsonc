{
  "name": "PlatformSetting",
  "type": "object",
  "properties": {
    "onboarding_mode": {
      "type": "string",
      "enum": [
        "self_serve",
        "guided"
      ],
      "default": "self_serve",
      "title": "New User Onboarding Mode"
    }
  },
  "required": [
    "onboarding_mode"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}