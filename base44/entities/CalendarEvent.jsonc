{
  "name": "CalendarEvent",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant (Organization) ID",
      "description": "Multi-tenant isolation key \u2014 the organization this record belongs to. Enforced via RLS (data.tenant_id === user.data.tenant_id)."
    },
    "title": {
      "type": "string",
      "title": "Event Title"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "relief_effort",
        "volunteer_dispatch",
        "crisis_response",
        "supply_delivery",
        "coordination_meeting",
        "other"
      ],
      "default": "other",
      "title": "Event Type"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "start_time": {
      "type": "string",
      "format": "date-time",
      "title": "Start Time"
    },
    "end_time": {
      "type": "string",
      "format": "date-time",
      "title": "End Time"
    },
    "timezone": {
      "type": "string",
      "default": "UTC",
      "title": "Timezone"
    },
    "location": {
      "type": "string",
      "title": "Location / Crisis Zone"
    },
    "coordinates": {
      "type": "object",
      "title": "GPS Coordinates"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "active",
        "completed",
        "cancelled"
      ],
      "default": "planned",
      "title": "Status"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "assigned_team": {
      "type": "string",
      "title": "Assigned Team / Volunteers"
    },
    "volunteer_count": {
      "type": "number",
      "default": 0,
      "title": "Volunteer Count"
    },
    "population_affected": {
      "type": "number",
      "default": 0,
      "title": "Population Affected"
    },
    "contact_person": {
      "type": "string",
      "title": "Contact Person"
    }
  },
  "required": [
    "title",
    "event_type",
    "start_time",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}