{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant (Organization) ID",
      "description": "Multi-tenant isolation key \u2014 the organization this record belongs to."
    },
    "subject": {
      "type": "string",
      "title": "Subject"
    },
    "category": {
      "type": "string",
      "enum": [
        "bug",
        "question",
        "feature_request",
        "account",
        "data_ingestion",
        "other"
      ],
      "default": "question",
      "title": "Category"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium",
      "title": "Priority"
    },
    "description": {
      "type": "string",
      "title": "Description"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "resolved",
        "closed"
      ],
      "default": "open",
      "title": "Status"
    },
    "submitted_by": {
      "type": "string",
      "title": "Submitted By"
    },
    "response": {
      "type": "string",
      "title": "Support Response"
    }
  },
  "required": [
    "subject",
    "description"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}