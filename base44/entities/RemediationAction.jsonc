{
  "name": "RemediationAction",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant (Organization) ID",
      "description": "Multi-tenant isolation key \u2014 the organization this record belongs to. Enforced via RLS (data.tenant_id === user.data.tenant_id)."
    },
    "action_type": {
      "type": "string",
      "enum": [
        "freeze_transaction",
        "suspend_vendor",
        "deploy_kyb",
        "escalate"
      ],
      "title": "Action Type"
    },
    "target_vendor": {
      "type": "string",
      "title": "Target Vendor"
    },
    "target_transaction_id": {
      "type": "string",
      "title": "Target Transaction ID"
    },
    "alert_id": {
      "type": "string",
      "title": "Source Alert ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "initiated",
        "in_progress",
        "completed",
        "failed"
      ],
      "default": "initiated",
      "title": "Status"
    },
    "triggered_by": {
      "type": "string",
      "title": "Triggered By"
    },
    "notes": {
      "type": "string",
      "title": "Notes"
    }
  },
  "required": [
    "action_type",
    "target_vendor",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}