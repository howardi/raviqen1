{
  "name": "PayrollRecord",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant (Organization) ID",
      "description": "Multi-tenant isolation key \u2014 the organization this record belongs to."
    },
    "employee_id": {
      "type": "string",
      "title": "Employee ID"
    },
    "employee_name": {
      "type": "string",
      "title": "Employee Name"
    },
    "department": {
      "type": "string",
      "title": "Department"
    },
    "pay_period_month": {
      "type": "string",
      "title": "Pay Period Month"
    },
    "pay_period_year": {
      "type": "number",
      "title": "Pay Period Year"
    },
    "base_salary": {
      "type": "number",
      "default": 0,
      "title": "Base Salary"
    },
    "hourly_rate": {
      "type": "number",
      "default": 0,
      "title": "Hourly Rate"
    },
    "scheduled_days": {
      "type": "number",
      "default": 22,
      "title": "Scheduled Working Days"
    },
    "scheduled_hours": {
      "type": "number",
      "default": 176,
      "title": "Scheduled Working Hours"
    },
    "days_worked": {
      "type": "number",
      "default": 0,
      "title": "Days Worked"
    },
    "hours_worked": {
      "type": "number",
      "default": 0,
      "title": "Total Hours Worked"
    },
    "regular_hours": {
      "type": "number",
      "default": 0,
      "title": "Regular Hours"
    },
    "overtime_hours": {
      "type": "number",
      "default": 0,
      "title": "Overtime Hours"
    },
    "overtime_pay": {
      "type": "number",
      "default": 0,
      "title": "Overtime Pay"
    },
    "late_count": {
      "type": "number",
      "default": 0,
      "title": "Late Arrivals"
    },
    "late_deduction": {
      "type": "number",
      "default": 0,
      "title": "Late Deduction"
    },
    "absent_days": {
      "type": "number",
      "default": 0,
      "title": "Absent Days"
    },
    "absence_deduction": {
      "type": "number",
      "default": 0,
      "title": "Absence Deduction"
    },
    "gross_pay": {
      "type": "number",
      "default": 0,
      "title": "Gross Pay"
    },
    "total_deductions": {
      "type": "number",
      "default": 0,
      "title": "Total Deductions"
    },
    "net_pay": {
      "type": "number",
      "default": 0,
      "title": "Net Pay"
    },
    "attendance_summary": {
      "type": "object",
      "title": "Attendance Summary"
    },
    "daily_breakdown": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Daily Breakdown"
    },
    "anomaly_flags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Anomaly Flags"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "low",
      "title": "Risk Level"
    },
    "risk_score": {
      "type": "number",
      "default": 0,
      "title": "Risk Score"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reviewed",
        "approved",
        "disbursed",
        "flagged"
      ],
      "default": "draft",
      "title": "Payroll Status"
    },
    "payslip_url": {
      "type": "string",
      "title": "Payslip URL"
    },
    "generated_by": {
      "type": "string",
      "title": "Generated By"
    },
    "generated_date": {
      "type": "string",
      "format": "date-time",
      "title": "Generated Date"
    },
    "approved_by": {
      "type": "string",
      "title": "Approved By"
    },
    "approved_date": {
      "type": "string",
      "format": "date",
      "title": "Approved Date"
    },
    "biometric_verification": {
      "type": "object",
      "title": "Biometric Verification Summary"
    },
    "manual_overrides": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Manual Override Log"
    }
  },
  "required": [
    "employee_id",
    "pay_period_month",
    "pay_period_year",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}