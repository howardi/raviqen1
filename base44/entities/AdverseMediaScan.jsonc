{
  "name": "AdverseMediaScan",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "title": "Tenant (Organization) ID",
      "description": "Multi-tenant isolation key \u2014 the organization this record belongs to. Enforced via RLS (data.tenant_id === user.data.tenant_id)."
    },
    "vendor": {
      "type": "string",
      "title": "Vendor / Entity Name"
    },
    "scan_date": {
      "type": "string",
      "format": "date-time",
      "title": "Scan Date"
    },
    "status": {
      "type": "string",
      "enum": [
        "scanning",
        "completed",
        "failed"
      ],
      "default": "scanning",
      "title": "Scan Status"
    },
    "risk_rating": {
      "type": "string",
      "enum": [
        "clear",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "clear",
      "title": "Adverse Media Risk Rating"
    },
    "findings_count": {
      "type": "number",
      "title": "Total Findings",
      "default": 0
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "title": "Adverse Media Findings"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "title": "Risk Categories"
    },
    "summary": {
      "type": "string",
      "title": "AI Summary"
    },
    "recommended_action": {
      "type": "string",
      "title": "Recommended Action"
    },
    "scanned_by": {
      "type": "string",
      "title": "Scanned By"
    }
  },
  "required": [
    "vendor",
    "scan_date",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tenant_id": "{{user.data.tenant_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}