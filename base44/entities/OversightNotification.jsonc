{
  "name": "OversightNotification",
  "type": "object",
  "properties": {
    "tenant_id": { "type": "string" },
    "user_id": { "type": "string" },
    "report_id": { "type": "string" },
    "department": { "type": "string" },
    "title": { "type": "string" },
    "read_at": { "type": "string" }
  },
  "required": ["tenant_id", "user_id", "title"],
  "rls": {
    "read": {
      "$and": [
        { "data.tenant_id": "{{user.data.tenant_id}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "create": { "user_condition": { "role": "oversight_immutable" } },
    "update": {
      "$and": [
        { "data.tenant_id": "{{user.data.tenant_id}}" },
        { "data.user_id": "{{user.id}}" }
      ]
    },
    "delete": { "user_condition": { "role": "oversight_immutable" } }
  }
}
