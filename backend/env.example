PORT=4000
MONGODB_DB=raviqen
MONGODB_USER=
MONGODB_PASSWORD=
# Cluster host from Atlas → Database → Connect. Example: raviqen.abcde.mongodb.net
MONGODB_HOST=
# Or paste the full connection string instead of user, password, and host.
MONGODB_URI=
# Voyage AI embeddings. This is not the database connection.
MONGODB_AI_ENDPOINT=https://ai.mongodb.com
MONGODB_AI_API_KEY=
# Chat models used by /api/ai. Claude answers first. Do not commit real keys.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cursor user API key from https://cursor.com/dashboard → API Keys. Used when OpenAI has no credits.
CURSOR_API_KEY=
CURSOR_MODEL=composer-2.5
# Gemini API key from Google AI Studio. Do not commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_PROJECT=
